{
    "name": "holdemiq",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "main": "electron-main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "tsc && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "desktop": "npm run build && electron .",
        "desktop:build": "npm run build && electron-builder --win portable"
    },
    "dependencies": {
        "@capacitor/android": "^8.6.2",
        "@capacitor/cli": "^8.6.2",
        "@capacitor/core": "^8.6.2",
        "react": "^18.3.1",
        "react-dom": "^18.3.1"
    },
    "devDependencies": {
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "electron": "^45.5.0",
        "electron-builder": "^26.18.0",
        "postcss": "^8.4.49",
        "tailwindcss": "^3.4.15",
        "typescript": "^5.6.3",
        "vite": "^6.0.1",
        "vitest": "^2.1.5"
    },
    "build": {
        "appId": "com.holdemiq.app",
        "productName": "HoldemIQ",
        "files": [
            "dist/**/*",
            "electron-main.cjs"
        ],
        "win": {
            "target": "portable"
        }
    }
}
